class Solution {
public:
    int longestPalindromeSubsequenceHalf(const string &s) {
        int n = s.size();
        string t = s;
        reverse(t.begin(), t.end());

        vector<vector<int>> dp(n, vector<int>(n, 0));

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                int now = (s[i] == t[j]) ? 1 : 0;
                int mx = 0, nc = 0;
                if (i > 0) mx = max(dp[i - 1][j], mx);
                if (j > 0) mx = max(dp[i][j - 1], mx);
                if (i > 0 && j > 0) nc = dp[i - 1][j - 1];
                dp[i][j] = max(nc + now, mx);
            }
        }

        return dp[n - 1][n - 1] / 2;
    }
};
