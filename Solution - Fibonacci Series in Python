import sys

# Increase recursion depth to handle N = 100 safely
sys.setrecursionlimit(2000)

def fib(n, memo={}):
    # Base cases matching Sample 1 and Sample 2
    if n == 1:
        return 0
    if n == 2:
        return 1
        
    # Return already calculated value
    if n in memo:
        return memo[n]
        
    # Recursive state transition with memoization
    memo[n] = fib(n - 1, memo) + fib(n - 2, memo)
    return memo[n]

# CodeChef I/O handling
if __name__ == '__main__':
    n = int(input())
    print(fib(n))
