class Solution {
public:
    int calculateMinFallingPathSum(vector<vector<int>>& matrix) {
        int n = matrix.size();
        vector<vector<int>> dp(n, vector<int>(n, 0));

        // Base row
        for (int j = 0; j < n; j++) {
            dp[0][j] = matrix[0][j];
        }

        // Fill DP
        for (int i = 1; i < n; i++) {
            for (int j = 0; j < n; j++) {
                int best = dp[i-1][j];  // top

                if (j > 0)
                    best = min(best, dp[i-1][j-1]);  // top-left

                if (j < n - 1)
                    best = min(best, dp[i-1][j+1]);  // top-right

                dp[i][j] = matrix[i][j] + best;
            }
        }

        // Final answer is the minimum in the last row
        return *min_element(dp[n-1].begin(), dp[n-1].end());
    }
};
