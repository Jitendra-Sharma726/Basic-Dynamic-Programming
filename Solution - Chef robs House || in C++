class Solution {
public:

    // Proper DP for the linear version
    int robLinear(const vector<int>& nums) {
        int n = nums.size();
        if (n == 0) return 0;
        if (n == 1) return nums[0];

        vector<int> dp(n);
        dp[0] = nums[0];
        dp[1] = max(nums[0], nums[1]);

        for (int i = 2; i < n; i++) {
            dp[i] = max(dp[i - 1], dp[i - 2] + nums[i]);
        }

        return dp[n - 1];
    }
    
    int calculateMaxRobAmount(const vector<int>& houseMoneyList) {
        int n = houseMoneyList.size();
        if (n == 0) return 0;
        if (n == 1) return houseMoneyList[0];

        // Case 1: Exclude last
        vector<int> case1(houseMoneyList.begin(), houseMoneyList.end() - 1);

        // Case 2: Exclude first
        vector<int> case2(houseMoneyList.begin() + 1, houseMoneyList.end());

        return max(robLinear(case1), robLinear(case2));
    }
};
