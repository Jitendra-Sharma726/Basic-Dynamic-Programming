bool canPartitionEqualSubset(vector<int>& numbers) {
    int sum = accumulate(numbers.begin(), numbers.end(), 0);
    if (sum % 2 != 0) return false;

    int target = sum / 2;
    vector<bool> dp(target + 1, false);
    dp[0] = true;

    for (int x : numbers) {
        for (int j = target; j >= x; j--) {
            dp[j] = dp[j] || dp[j - x];
        }
    }
    return dp[target];
}
