class Solution {
public:
    long long calculateUniquePaths(int rowCount, int columnCount) {
        vector<vector<long long>> dp(rowCount, vector<long long>(columnCount, 0));

        // Initialize first row and first column
        for (int i = 0; i < rowCount; i++) dp[i][0] = 1;
        for (int j = 0; j < columnCount; j++) dp[0][j] = 1;

        // Fill DP table
        for (int i = 1; i < rowCount; i++) {
            for (int j = 1; j < columnCount; j++) {
                dp[i][j] = dp[i - 1][j] + dp[i][j - 1];
            }
        }

        return dp[rowCount - 1][columnCount - 1];
    }
};
